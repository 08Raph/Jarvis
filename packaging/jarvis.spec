# PyInstaller one-folder spec: builds BOTH jarvis.exe (console, command line) and jarvis-gui.exe (windowed, the desktop window).
# NOT YET BUILT OR TESTED ON WINDOWS (no Windows/PyInstaller/PySide6 in the authoring sandbox).
# One-folder (not one-file) keeps Qt (LGPL) as separate, replaceable DLLs, avoids unpacking to %TEMP% on every start, and is what the installer expects.
# Build (use scripts\build_windows.ps1, which checks everything first):  pyinstaller packaging\jarvis.spec --noconfirm --clean
# The asset list lives in packaging\manifest.py (shared with scripts\check_release_assets.py and the tests).
import importlib.util
import os
import sys

from PyInstaller.utils.hooks import collect_data_files, collect_dynamic_libs, collect_submodules

here = SPECPATH
root = os.path.abspath(os.path.join(here, ".."))
sys.path.insert(0, here)
import manifest  # noqa: E402  (packaging/manifest.py)

# 1. Fail clearly - never produce a half-working build - when a mandatory package is missing.
_missing = [m for m in manifest.MANDATORY_PACKAGES_FOR_RELEASE if importlib.util.find_spec(m) is None]
if _missing:
    raise SystemExit("BUILD BLOCKED: mandatory package(s) not installed in the build Python: " + ", ".join(_missing)
                     + '  ->  pip install -e ".[ui,build,desktop]"')

# 2. Mandatory data files must exist (build_info.json is generated by scripts\release_tools.py build-info).
datas = []
for src, dest in manifest.DATAS:
    path = os.path.join(root, *src.split("/"))
    if not os.path.isfile(path):
        raise SystemExit(f"BUILD BLOCKED: mandatory file missing: {src}")
    datas.append((path, dest))
for doc in manifest.DOCS:
    path = os.path.join(root, "docs", doc)
    if not os.path.isfile(path):
        raise SystemExit(f"BUILD BLOCKED: documentation missing: docs/{doc}")
    datas.append((path, "docs"))

# Time-zone database (Windows has none; scheduling in named zones needs it). Only present on Windows builds.
if importlib.util.find_spec("tzdata") is not None:
    datas += collect_data_files("tzdata")

# 3. Optional runtimes (local AI, voice, UI Automation) are bundled only if installed in the build environment;
#    build_windows.ps1 then verifies the frozen exe with `jarvis.exe runtime --require`.
binaries, hidden = [], list(manifest.HIDDEN_REQUIRED)
for mod in manifest.OPTIONAL_PACKAGES + ["PySide6"]:
    if importlib.util.find_spec(mod) is None:
        continue
    try:
        binaries += collect_dynamic_libs(mod)
        hidden += collect_submodules(mod)
    except Exception as e:   # a hook failure must be visible, not silent
        print(f"WARNING: could not collect {mod}: {e}")
# The natural-voice engine (Kokoro) and everything it needs, only if it was installed in the build environment (build_windows.ps1 -WithKokoro).
if importlib.util.find_spec("kokoro_onnx") is not None:
    from PyInstaller.utils.hooks import collect_data_files, collect_dynamic_libs
    for _dist in manifest.dist_closure(manifest.KOKORO_ROOT_DIST):
        for _mod in manifest.top_level_modules(_dist):
            if _mod in manifest.KOKORO_SKIP_MODULES or importlib.util.find_spec(_mod) is None:
                continue
            try:
                datas += collect_data_files(_mod)
                binaries += collect_dynamic_libs(_mod)
                hidden += [h for h in collect_submodules(_mod)
                           if not any(part in manifest.KOKORO_SKIP_SUBMODULE_PARTS for part in h.split("."))]
            except Exception as e:   # a hook failure must be visible, not silent
                print(f"WARNING: could not collect {_mod} (from {_dist}): {e}")
hidden += collect_submodules("jarvis")
binaries = [b for b in binaries if not any(part in os.path.basename(b[0]).lower() for part in manifest.EXCLUDED_BINARY_NAME_PARTS)]
hidden = [h for h in hidden if not any(h == x or h.startswith(x + ".") for x in manifest.QT_EXCLUDES)]

# The local sign-in server (jarvis local-server) lives in server/; freeze it so the exe can run it.
hidden += collect_submodules(manifest.SERVER_PACKAGE, on_error="warn") if os.path.isdir(os.path.join(root, "server", manifest.SERVER_PACKAGE)) else []
_common = dict(pathex=[os.path.join(root, "src"), os.path.join(root, "server")], datas=datas, hiddenimports=hidden, binaries=binaries, excludes=manifest.EXCLUDES)
cli = Analysis([os.path.join(here, "entry_cli.py")], **_common)
gui = Analysis([os.path.join(here, "entry_gui.py")], **_common)
# Drop 32-bit / ARM64 third-party DLLs from the FINAL lists (they can arrive as data files, not only as binaries, e.g. sounddevice's portaudio-binaries).
def _keep(entry):
    name = os.path.basename(str(entry[0])).lower()
    return not (name.endswith((".dll", ".pyd")) and any(part in name for part in manifest.EXCLUDED_BINARY_NAME_PARTS))
for _a in (cli, gui):
    _a.binaries = [e for e in _a.binaries if _keep(e)]
    _a.datas = [e for e in _a.datas if _keep(e)]
MERGE((cli, "jarvis", "jarvis"), (gui, "jarvis-gui", "jarvis-gui"))   # share one copy of Python, Qt and the libraries

cli_exe = EXE(PYZ(cli.pure), cli.scripts, [], exclude_binaries=True, name="jarvis", console=True, upx=False)
gui_exe = EXE(PYZ(gui.pure), gui.scripts, [], exclude_binaries=True, name="jarvis-gui", console=False, upx=False)
coll = COLLECT(cli_exe, cli.binaries, cli.datas, gui_exe, gui.binaries, gui.datas, name="ProjectJarvis", upx=False)
